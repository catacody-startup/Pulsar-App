{
  "name": "pulsar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Pulsar – health self-monitoring for astronauts on long-duration missions (NASA Space Apps Challenge 2026, team CataCody).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/face/copy-models.mjs && tsc -b && vite build && vite build --config vite.server.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build:server": "vite build --config vite.server.config.ts",
    "server": "npm run build:server && node dist-server/main.mjs",
    "predev": "node scripts/face/copy-models.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vladmandic/face-api": "1.7.15",
    "jspdf": "4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
